# Local demo only. Do not copy these values to a cloud provider.
DB_URL=jdbc:mysql://mysql:3306/smart_clinic
DB_USERNAME=smart_clinic
DB_PASSWORD=smart-clinic-local-only
# Cloud profile requires a separate Flyway migration identity. These local
# placeholders document the variables only; create a least-privileged migration
# user in the cloud database and use different non-local credentials there.
FLYWAY_DB_URL=jdbc:mysql://mysql:3306/smart_clinic
FLYWAY_DB_USERNAME=smart_clinic_flyway
FLYWAY_DB_PASSWORD=smart-clinic-flyway-local-only
MYSQL_ROOT_PASSWORD=smart-clinic-root-local-only
MONGODB_URI=mongodb://smart_clinic:smart-clinic-local-only@mongodb:27017/prescriptions?authSource=admin
MONGO_INITDB_ROOT_USERNAME=smart_clinic
MONGO_INITDB_ROOT_PASSWORD=smart-clinic-local-only
JWT_SECRET=smart-clinic-local-demo-signing-key-change-before-cloud-use
JWT_EXPIRATION=PT1H
SPRING_PROFILES_ACTIVE=demo

# Required only when SPRING_PROFILES_ACTIVE=cloud. Set managed values in Render;
# never commit production URLs, credentials, or JWT secrets.
CORS_ALLOWED_ORIGINS=https://clinic.example.com
APP_VERSION=dev
APP_REVISION=local
APP_ENVIRONMENT=local

# Cloud-only one-time identity bootstrap. Keep disabled locally. Never commit values.
APP_BOOTSTRAP_ENABLED=
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_DOCTOR_NAME=
APP_BOOTSTRAP_DOCTOR_SPECIALTY=
APP_BOOTSTRAP_DOCTOR_EMAIL=
APP_BOOTSTRAP_DOCTOR_PASSWORD=
APP_BOOTSTRAP_DOCTOR_PHONE=
APP_BOOTSTRAP_DOCTOR_AVAILABLE_TIMES=
